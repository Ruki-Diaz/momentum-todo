# Momentum — Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env.

# ── Neon PostgreSQL ──────────────────────────────────────────────
# SERVER ONLY — never exposed to the browser
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require"

# ── Clerk Authentication ─────────────────────────────────────────
# SERVER ONLY — never exposed to the browser
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# PUBLIC — safe to expose; served via GET /api/auth/config (never embedded in static JS)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"

# ── Authorized Parties ───────────────────────────────────────────
# Comma-separated list of production origin(s) added to Clerk's authorizedParties.
# Localhost origins are always included automatically.
# Example for production: AUTHORIZED_PARTIES="https://your-app.vercel.app"
# Example for custom domain: AUTHORIZED_PARTIES="https://momentum.example.com"
# Leave blank in development (localhost origins are included by default).
AUTHORIZED_PARTIES=""

# ── Runtime Environment ──────────────────────────────────────────
# Set to "production" on Vercel; "development" locally.
NODE_ENV="development"

# ── Stage 6: Momentum Intelligence ──────────────────────────────
# SERVER ONLY — never exposed to the browser or client-side assets
# Enable/disable Momentum Intelligence (default: false)
AI_ENABLED="false"

# Provider adapter: "google" | "openai" | "stub" (default: stub for dev/test)
AI_PROVIDER="stub"

# Model: gemini-3.1-flash-lite (Google) or gpt-5.6-luna (OpenAI)
AI_MODEL="gemini-3.1-flash-lite"

# Google Gemini API Key (SERVER ONLY) — required when AI_PROVIDER="google"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI API Key (SERVER ONLY) — required when AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"

# Application Daily Rate Limit per User (default: 25 requests per UTC day)
AI_DAILY_REQUEST_LIMIT="25"

# Context and timeout guardrails
AI_MAX_CONTEXT_TASKS="50"
AI_TIMEOUT_MS="30000"

