# Momentum — Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env.

# ── Neon PostgreSQL ──────────────────────────────────────────────
# SERVER ONLY — never exposed to the browser
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require"

# ── Clerk Authentication ─────────────────────────────────────────
# SERVER ONLY — never exposed to the browser
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# PUBLIC — safe to expose; served via GET /api/auth/config (never embedded in static JS)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"

# ── Authorized Parties ───────────────────────────────────────────
# Comma-separated list of production origin(s) added to Clerk's authorizedParties.
# Localhost origins are always included automatically.
# Example for production: AUTHORIZED_PARTIES="https://your-app.vercel.app"
# Example for custom domain: AUTHORIZED_PARTIES="https://momentum.example.com"
# Leave blank in development (localhost origins are included by default).
AUTHORIZED_PARTIES=""

# ── Runtime Environment ──────────────────────────────────────────
# Set to "production" on Vercel; "development" locally.
NODE_ENV="development"
