{
  "version": 2,
  "buildCommand": "tsc --noEmit",
  "outputDirectory": "public",
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/config",
      "destination": "/api/auth/me?action=config"
    },
    {
      "source": "/api/tasks/:id/complete",
      "destination": "/api/tasks/:id?action=complete"
    },
    {
      "source": "/api/ai/status",
      "destination": "/api/ai?action=status"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
